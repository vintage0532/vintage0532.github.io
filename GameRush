<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GameRush 🎮</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #0b0b16;
      color: white;
    }

    header {
      background: #15152a;
      padding: 18px;
      text-align: center;
      border-bottom: 2px solid #6c2cff;
    }

    header h1 {
      font-size: 32px;
      color: #9b5cff;
    }

    header p {
      margin-top: 6px;
      color: #bbb;
    }

    .hero {
      text-align: center;
      padding: 60px 20px;
    }

    .hero h2 {
      font-size: 38px;
      margin-bottom: 15px;
    }

    .hero span {
      color: #9b5cff;
    }

    .hero p {
      color: #aaa;
      margin-bottom: 25px;
    }

    .btn {
      display: inline-block;
      background: #7b2cff;
      color: white;
      padding: 13px 25px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: bold;
    }

    .games {
      padding: 25px 18px 50px;
    }

    .games h2 {
      text-align: center;
      margin-bottom: 25px;
    }

    .game-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      max-width: 1000px;
      margin: auto;
    }

    .game-card {
      background: #17172b;
      padding: 25px;
      border-radius: 15px;
      text-align: center;
      border: 1px solid #29294a;
    }

    .game-card .emoji {
      font-size: 55px;
      margin-bottom: 12px;
    }

    .game-card h3 {
      margin-bottom: 8px;
    }

    .game-card p {
      color: #aaa;
      margin-bottom: 18px;
    }

    footer {
      text-align: center;
      padding: 20px;
      background: #15152a;
      color: #888;
    }
  </style>
</head>

<body>

  <header>
    <h1>🎮 GameRush</h1>
    <p>Play. Challenge. Enjoy.</p>
  </header>

  <section class="hero">
    <h2>Welcome to <span>GameRush</span>!</h2>
    <p>Your ultimate gaming zone.</p>
    <a href="#games" class="btn">Explore Games 🎮</a>
  </section>

  <section class="games" id="games">
    <h2>🔥 Popular Games</h2>

    <div class="game-container">

      <div class="game-card">
        <div class="emoji">🚀</div>
        <h3>Space Rush</h3>
        <p>Ready for an exciting space adventure?</p>
        <a href="#" class="btn">Play</a>
      </div>

      <div class="game-card">
        <div class="emoji">🏎️</div>
        <h3>Speed Racer</h3>
        <p>Race your way to the top!</p>
        <a href="#" class="btn">Play</a>
      </div>

      <div class="game-card">
        <div class="emoji">⚔️</div>
        <h3>Battle Arena</h3>
        <p>Enter the ultimate battle!</p>
        <a href="#" class="btn">Play</a>
      </div>

    </div>
  </section>

  <footer>
    © 2026 GameRush | All Rights Reserved
  </footer>

</body>
</html>
